# Copia este archivo a .env (NO subas .env a GitHub) y completa los valores.
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
DEBUG=True

# Vacío = SQLite local. Con Neon: la cadena que te da el panel (debe terminar en ?sslmode=require)
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Vacío = imágenes en la carpeta media/. Con Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@mi-cloud

# Opcional: protege /salud/db/ (se llama /salud/db/?token=...)
# SALUD_TOKEN=un-texto-largo-que-solo-sepas-tu

# Opcionales: dominio propio
# ALLOWED_HOSTS=sistema.mitienda.com
# CSRF_TRUSTED_ORIGINS=https://sistema.mitienda.com
